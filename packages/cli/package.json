{
  "name": "@cobaltforge/cli",
  "version": "0.2.0",
  "description": "cobalt (alias cb): the cobalt command line. It never asks questions and every command speaks JSON.",
  "type": "module",
  "bin": {
    "cb": "./src/main.ts",
    "cobalt": "./src/main.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "varlock": "1.25.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@cobaltforge/api": "workspace:*"
  },
  "exports": {
    "./*": "./src/*.ts"
  }
}
